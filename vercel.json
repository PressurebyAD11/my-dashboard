{
  "version": 2,
  "routes": [
    {
      "src": "/auth/(.*)",
      "dest": "fastforward-dashboard/server/index.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "fastforward-dashboard/server/index.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "fastforward-dashboard/client/dist/index.html"
    }
  ]
}
